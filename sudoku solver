
#include <iostream>
#include <math.h>
using namespace std;
// rows, columns respectively
void Print(int board[][9], int n)
{
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++){
            cout << board[i][j] << " ";}
        cout << endl; }
    cout << endl;
}
// in a subgrid, we always find the starting point of each submatrix
bool is_valid(int board[][9], int i, int j, int num, int n) // important
{
    // Row and column check respectively
    for (int x = 0; x < n; x++){
        if (board[i][x] == num || board[x][j] == num) {return false;}
    }
    int rn = sqrt(n);
    int si = i - i % rn;
    int sj = j - j % rn;
    
    for (int x = si; x < si + rn; x++) {
        for (int y = sj; y < sj + rn; y++)
        {
            if (board[x][y] == num) return false;
        }
    }
    return true;
}

bool SudokuSolver(int board[][9], int i, int j, int n)
{
    // base case, after solving board
    if (i == n) {
        Print(board, n);
        return true;
    }
    // if we are not in the board
    if (j == n) {
        return SudokuSolver(board, i + 1, 0, n);
    }
    // if cell is already filled -> move forwards
    if (board[i][j] != 0)
    {
        return SudokuSolver(board, i, j + 1, n);
    }
    
    // try to fill cell with n appropriate number
    for (int num = 1; num <= 9; num++)
    {
        // Check if number can be filled
        if(is_valid(board, i, j, num, n)) {
            board[i][j] = num;
            // move forward
            bool subAns = SudokuSolver(board, i, j + 1, n);
            if (subAns)
            {
                return true;
            }
            // Backtracking -> undo changes if we went wrong
            board[i][j] = 0;
            
        }
    }
    return false;
    
}
int main()
{
    int n = 9;
    int board[9][9] = {
        {0, 0, 7, 1, 0, 0, 0, 6, 0},
        {1, 0, 5, 2, 0, 8, 0, 0, 0},
        {6, 0, 0, 0, 0, 7, 1, 2, 0},
        {3, 1, 2, 4, 0, 5, 0, 0, 8},
        {0, 0, 6, 0, 9, 0, 2, 0, 0},
        {0, 0, 0, 0, 0, 3, 0, 0, 1},
        {0, 0, 0, 0, 0, 4, 9, 8, 6},
        {8, 0, 3, 9, 0, 6, 0, 0, 0},
        {0, 6, 0, 0, 8, 2, 7, 0, 3},
    };
    SudokuSolver(board, 0, 0, n);

    return 0;
}

